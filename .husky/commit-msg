#!/bin/sh

# 커밋 메시지 파일의 경로를 인자로 받습니다.
COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Conventional Commits 패턴 정의 (Supabase 전용 db, func 타입 추가)
# 형식: type(scope): subject 또는 type: subject
REGEXP="^(feat|fix|docs|style|refactor|test|chore|revert)(\([a-zA-Z0-9_-]+\))?: .+"

if ! echo "$COMMIT_MSG" | grep -Eq "$REGEXP"; then
  echo "❌ [에러] 올바르지 않은 커밋 메시지 형식입니다."
  echo ""
  echo "커밋 메시지는 Conventional Commits 규격을 따라야 합니다:"
  echo "  <타입>(<범위>): <설명> (범위는 생략 가능)"
  echo ""
  echo "사용 가능한 타입(Type):"
  echo "  feat     : 새로운 기능 추가"
  echo "  fix      : 버그 수정"
  echo "  docs     : 문서 수정"
  echo "  style    : 코드 포맷팅, 세미콜론 누락 등 (코드 변경 없음)"
  echo "  refactor : 코드 리팩토링"
  echo "  test     : 테스트 코드 추가/수정"
  echo "  chore    : 빌드 태스크, 패키지 매니저 설정 등 (기타 변경)"
  echo "  revert   : 이전 커밋 되돌리기"
  echo ""
  echo "올바른 예시:"
  echo "  feat: 카카오 로그인 기능 추가"
  echo "  fix: 로그인 에러 수정"
  exit 1
fi

echo "✅ commit-msg 검사 통과!"
